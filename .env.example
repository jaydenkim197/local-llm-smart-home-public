# Use simulation until the Home Assistant token is configured.
CONTROL_BACKEND=simulation
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=replace-with-a-long-lived-access-token
# Optional Aqara Advanced Matter Bridging Scene Sync endpoints for IR AC control.
# Both must be configured before climate.air_conditioner is exposed physically.
HOME_ASSISTANT_AC_COOL_ENTITY=
HOME_ASSISTANT_AC_OFF_ENTITY=
HOME_ASSISTANT_AC_SCENE_RESET_DELAY=2.0

# Keep the actual home coordinates in the ignored .env, not in Git.
HOME_LATITUDE=
HOME_LONGITUDE=
HOME_ELEVATION_M=0
HOME_TIMEZONE=Asia/Seoul
# Optional: living-room window direction, clockwise degrees from true north.
HOME_WINDOW_AZIMUTH_DEG=

# Optional outdoor weather and radiation context. No API key is required.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT=4
OPEN_METEO_CACHE_SECONDS=600

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=45

WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
